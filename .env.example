# ============================================================
# BRChain — variáveis de ambiente (modelo)
# Copie para .env.local e preencha. NUNCA commite .env.local.
# ============================================================

# ---- Banco de dados (MySQL 8+) — Persistência ----
# Opção A: uma única URL de conexão (recomendado p/ PlanetScale, Railway, etc.)
# DATABASE_URL=mysql://usuario:senha@host:3306/brchain
# Opção B: variáveis discretas (use se não definir DATABASE_URL)
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DATABASE=brchain
# MYSQL_SSL=true   # habilite em provedores que exigem TLS

# ---- Autenticação do Painel de Curadoria ----
# Segredo para assinar o cookie de sessão do moderador (HMAC).
# Gere um valor aleatório: openssl rand -hex 32
AUTH_SECRET=

# ---- GNews (fonte de notícias) ----
# https://gnews.io → conta gratuita (100 req/dia)
GNEWS_API_KEY=

# ---- Cron de ingestão ----
# Segredo para proteger /api/ingest de chamadas públicas.
# Gere um valor aleatório (ex.: openssl rand -hex 32). A Vercel envia
# automaticamente o header Authorization: Bearer <CRON_SECRET> nos crons.
CRON_SECRET=

# ---- Resend (envio do formulário "Fale com um Especialista") ----
# https://resend.com → API Keys
RESEND_API_KEY=
# Remetente verificado no Resend (domínio verificado). Ex.: "BRChain <no-reply@brchain.com.br>"
CONTACT_FROM_EMAIL=
# Destino dos contatos comerciais
CONTACT_TO_EMAIL=contato@brchain.com.br

# ---- Site ----
# URL pública (usada em metadados/SEO). Em dev: http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000
