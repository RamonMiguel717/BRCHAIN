# ============================================================
# BRChain — variáveis de ambiente (modelo)
# Copie para .env.local e preencha. NUNCA commite .env.local.
# ============================================================

# ---- Supabase (Backend/Persistência + Auth) ----
# Painel Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Service role: usada SOMENTE no servidor (cron de ingestão). Bypassa RLS. Mantenha secreta.
SUPABASE_SERVICE_ROLE_KEY=

# ---- GNews (fonte de notícias) ----
# https://gnews.io → conta gratuita (100 req/dia)
GNEWS_API_KEY=

# ---- Cron de ingestão ----
# Segredo para proteger /api/ingest de chamadas públicas.
# Gere um valor aleatório (ex.: openssl rand -hex 32). A Vercel envia
# automaticamente o header Authorization: Bearer <CRON_SECRET> nos crons.
CRON_SECRET=

# ---- Resend (envio do formulário "Fale com um Especialista") ----
# https://resend.com → API Keys
RESEND_API_KEY=
# Remetente verificado no Resend (domínio verificado). Ex.: "BRChain <no-reply@brchain.com.br>"
CONTACT_FROM_EMAIL=
# Destino dos contatos comerciais
CONTACT_TO_EMAIL=contato@brchain.com.br

# ---- Site ----
# URL pública (usada em metadados/SEO). Em dev: http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000