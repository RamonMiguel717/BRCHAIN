# ============================================================
# BRChain — variáveis para o Docker Compose
# Copie para .env (na raiz) e ajuste. O compose carrega .env
# automaticamente. NUNCA commite o .env (já está no .gitignore).
# ============================================================

# ---- MySQL (serviço `db`) ----
MYSQL_ROOT_PASSWORD=root
MYSQL_DATABASE=brchain
MYSQL_USER=brchain
MYSQL_PASSWORD=brchain

# ---- Autenticação do Painel ----
# Gere: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=troque-por-um-valor-aleatorio
# Flag Secure do cookie de sessão. "false" para HTTP local; "true" atrás de HTTPS.
COOKIE_SECURE=false

# ---- Integrações (opcionais) ----
GNEWS_API_KEY=
CRON_SECRET=
RESEND_API_KEY=
CONTACT_FROM_EMAIL=
CONTACT_TO_EMAIL=contato@brchain.com.br

# ---- Site ----
NEXT_PUBLIC_SITE_URL=http://localhost:3000
